{
  "name": "clinic-concierge-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP-сервер клиники: поиск по базе знаний (Neon + Voyage) и отправка заявки в Make.com",
  "type": "module",
  "bin": {
    "clinic-concierge-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "setup": "npm install --prefix ../concierge-api && npm install && npm run build",
    "check": "node scripts/check.mjs",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
